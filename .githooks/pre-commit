#!/bin/sh
# Stamp each asset's content hash into its ?v= query in index.html and zh.html, so the
# year-long immutable cache in vercel.json never serves a stale file.
# Enable once per clone: git config core.hooksPath .githooks
set -e
for f in styles.css script.js demos.js fonts/fonts.css; do
  v=$(git show ":$f" | shasum | cut -c1-8)
  perl -pi -e "s#\Q$f\E\?v=[^\"]*#$f?v=$v#g" index.html zh.html
done
# ponytail: re-stages both pages whole, including any unstaged edits to them
git add index.html zh.html
